---
const slides = [
  { src: "/images/hero-slide.svg", alt: "ヒーロー画像 1", showNews: false },
  { src: "/images/hero-slide.svg", alt: "ヒーロー画像 2", showNews: true },
  { src: "/images/hero-slide.svg", alt: "ヒーロー画像 3", showNews: true },
];
---

<section class="hero" aria-label="ヒーローセクション">
  <div class="hero-carousel" data-hero-carousel>
    <div class="hero-track" data-hero-track>
      {slides.map((slide) => (
        <div class="hero-slide">
          <img src={slide.src} alt={slide.alt} width="1920" height="1080" />
          {slide.showNews && <p class="hero-label">News</p>}
        </div>
      ))}
    </div>

    <button class="hero-control hero-control-prev" type="button" aria-label="前の画像へ" data-hero-prev>
      <span aria-hidden="true">‹</span>
    </button>
    <button class="hero-control hero-control-next" type="button" aria-label="次の画像へ" data-hero-next>
      <span aria-hidden="true">›</span>
    </button>

    <div class="hero-dots" aria-label="スライド選択">
      {slides.map((_, index) => (
        <button
          class="hero-dot"
          type="button"
          aria-label={`${index + 1}枚目の画像へ`}
          aria-current={index === 0 ? "true" : "false"}
          data-hero-dot
          data-slide-index={index}
        />
      ))}
    </div>
  </div>
</section>

<script>
  const carousel = document.querySelector("[data-hero-carousel]");

  if (carousel) {
    const track = carousel.querySelector("[data-hero-track]");
    const slides = Array.from(carousel.querySelectorAll(".hero-slide"));
    const prevButton = carousel.querySelector("[data-hero-prev]");
    const nextButton = carousel.querySelector("[data-hero-next]");
    const dotButtons = Array.from(carousel.querySelectorAll("[data-hero-dot]"));
    let currentIndex = 0;
    let autoSlideTimer;

    const updateSlide = () => {
      if (!(track instanceof HTMLElement)) return;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      dotButtons.forEach((dot, index) => {
        dot.setAttribute("aria-current", String(index === currentIndex));
      });
    };

    const goToSlide = (index) => {
      currentIndex = (index + slides.length) % slides.length;
      updateSlide();
    };

    const goToPrevSlide = () => {
      goToSlide(currentIndex - 1);
    };

    const goToNextSlide = () => {
      goToSlide(currentIndex + 1);
    };

    const startAutoSlide = () => {
      window.clearInterval(autoSlideTimer);
      autoSlideTimer = window.setInterval(goToNextSlide, 5000);
    };

    prevButton?.addEventListener("click", () => {
      goToPrevSlide();
      startAutoSlide();
    });

    nextButton?.addEventListener("click", () => {
      goToNextSlide();
      startAutoSlide();
    });

    dotButtons.forEach((dot) => {
      dot.addEventListener("click", () => {
        const slideIndex = Number(dot.getAttribute("data-slide-index"));
        if (Number.isNaN(slideIndex)) return;
        goToSlide(slideIndex);
        startAutoSlide();
      });
    });

    updateSlide();
    startAutoSlide();
  }
</script>

<style>
  .hero {
    width: 100%;
    background: #ffffff;
  }

  .hero-carousel {
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: calc(100vh - 72px);
    background: #ffffff;
  }

  .hero-track {
    display: flex;
    width: 100%;
    height: calc(100vh - 72px);
    min-height: 520px;
    transition: transform 1100ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
  }

  .hero-slide img {
    display: block;
    width: 100%;
    height: 100%;
    background: #ffffff;
    object-fit: cover;
  }

  .hero-label {
    position: absolute;
    top: 56px;
    left: 72px;
    margin: 0;
    color: #111827;
    font-size: 5.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0;
  }

  .hero-control {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid #d8e0ea;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: #111827;
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease;
  }

  .hero-control:hover,
  .hero-control:focus-visible {
    border-color: #1d4ed8;
    background: #ffffff;
    color: #1d4ed8;
  }

  .hero-control span {
    display: block;
    margin-top: -3px;
    font-size: 2.4rem;
    line-height: 1;
  }

  .hero-control-prev {
    left: 28px;
  }

  .hero-control-next {
    right: 28px;
  }

  .hero-dots {
    position: absolute;
    right: 0;
    bottom: 28px;
    left: 0;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 10px;
    pointer-events: none;
  }

  .hero-dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 1px solid rgba(17, 24, 39, 0.5);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.82);
    cursor: pointer;
    pointer-events: auto;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .hero-dot[aria-current="true"] {
    border-color: #111827;
    background: #111827;
    transform: scale(1.18);
  }

  @media (max-width: 760px) {
    .hero-carousel {
      min-height: calc(100vh - 64px);
    }

    .hero-track {
      height: calc(100vh - 64px);
      min-height: 500px;
    }

    .hero-slide img {
      object-fit: contain;
    }

    .hero-label {
      top: 34px;
      left: 28px;
      font-size: 3.4rem;
    }

    .hero-control {
      width: 42px;
      height: 42px;
    }

    .hero-control-prev {
      left: 16px;
    }

    .hero-control-next {
      right: 16px;
    }

    .hero-dots {
      bottom: 22px;
      gap: 9px;
    }

    .hero-dot {
      width: 9px;
      height: 9px;
    }
  }
</style>
