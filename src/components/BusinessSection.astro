---
const businessItems = [
  {
    title: "ああああ",
    text: "ああああああああああああああああ。ああああああああああ。",
  },
  {
    title: "ああああ",
    text: "ああああああああああああああああ。ああああああああああ。",
  },
  {
    title: "ああああ",
    text: "ああああああああああああああああ。ああああああああああ。",
  },
];
---

<section class="business-section" id="service" aria-labelledby="business-title">
  <div class="section-inner">
    <div class="section-heading">
      <p class="section-kicker">BUSINESS</p>
      <h2 id="business-title">事業内容</h2>
      <p class="section-description">
        ああああああああああああああああ。ああああああああああああああああ。
      </p>
    </div>

    <div class="business-grid">
      {businessItems.map((item, index) => (
        <article class="business-card">
          <span class="business-number">{String(index + 1).padStart(2, "0")}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .business-section {
    border-top: 1px solid #e5e7eb;
    background: #f8fafc;
  }

  .section-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 96px 24px;
  }

  .section-heading {
    display: grid;
    gap: 12px;
    max-width: 720px;
    margin-bottom: 42px;
  }

  .section-kicker {
    margin: 0;
    color: #6b7280;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .section-heading h2 {
    margin: 0;
    color: #111827;
    font-size: 2.2rem;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .section-description {
    margin: 8px 0 0;
    color: #4b5563;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.9;
  }

  .business-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .business-card {
    display: grid;
    gap: 18px;
    min-height: 260px;
    border: 1px solid #d7d7d7;
    border-radius: 8px;
    padding: 28px;
    background: #ffffff;
  }

  .business-number {
    color: #9ca3af;
    font-size: 0.86rem;
    font-weight: 800;
  }

  .business-card h3 {
    margin: 0;
    color: #111827;
    font-size: 1.24rem;
    line-height: 1.45;
  }

  .business-card p {
    margin: 0;
    color: #4b5563;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.9;
  }

  @media (max-width: 900px) {
    .section-inner {
      padding: 72px 18px;
    }

    .section-heading h2 {
      font-size: 1.8rem;
    }

    .business-grid {
      grid-template-columns: 1fr;
    }

    .business-card {
      min-height: auto;
    }
  }
</style>
