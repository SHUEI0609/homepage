---
const memberImage = "/images/member-placeholder.svg";

const members = [
  { name: "ああああ", role: "ああああ", text: "ああああああああああああ。", image: memberImage },
  { name: "ああああ", role: "ああああ", text: "ああああああああああああ。", image: memberImage },
  { name: "ああああ", role: "ああああ", text: "ああああああああああああ。", image: memberImage },
];
---

<section class="members-section" id="members" aria-labelledby="members-title">
  <div class="section-inner">
    <div class="section-heading">
      <p class="section-kicker">MEMBERS</p>
      <h2 id="members-title">主要メンバー</h2>
      <p>ああああああああああああああああ。ああああああああ。</p>
    </div>

    <div class="members-grid">
      {members.map((member) => (
        <article class="member-card">
          <div class="member-image-frame">
            <img class="member-image" src={member.image} alt="" loading="lazy" />
          </div>
          <div>
            <p class="member-role">{member.role}</p>
            <h3>{member.name}</h3>
            <p class="member-text">{member.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .members-section {
    border-top: 1px solid #e5e7eb;
    background: #ffffff;
  }

  .section-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 96px 24px;
  }

  .section-heading {
    display: grid;
    gap: 12px;
    max-width: 720px;
    margin-bottom: 42px;
  }

  .section-kicker,
  .member-role {
    margin: 0;
    color: #6b7280;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .section-heading h2 {
    margin: 0;
    color: #111827;
    font-size: 2.2rem;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .section-heading p:not(.section-kicker) {
    margin: 8px 0 0;
    color: #4b5563;
    font-weight: 600;
    line-height: 1.9;
  }

  .members-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .member-card {
    display: grid;
    gap: 22px;
    align-content: start;
    border: 1px solid #d7d7d7;
    border-radius: 8px;
    padding: 24px;
    background: #ffffff;
  }

  .member-image-frame {
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border-radius: 8px;
    background: #ffffff;
  }

  .member-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .member-card h3 {
    margin: 8px 0 0;
    color: #111827;
    font-size: 1.25rem;
    line-height: 1.4;
  }

  .member-text {
    margin: 12px 0 0;
    color: #4b5563;
    font-size: 0.94rem;
    font-weight: 600;
    line-height: 1.8;
  }

  @media (max-width: 900px) {
    .section-inner {
      padding: 72px 18px;
    }

    .section-heading h2 {
      font-size: 1.8rem;
    }

    .members-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
