---
const navItems = [
  { href: "#about", label: "会社について" },
  { href: "#service", label: "事業内容" },
  { href: "#members", label: "主要メンバー" },
  { href: "#contact", label: "お問い合わせ" },
  { href: "#details", label: "詳細" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="トップページへ">
      <img class="brand-logo" src="/images/logo.svg" alt="ろご" width="150" height="58" />
    </a>

    <nav class="nav" aria-label="グローバルナビゲーション">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <a class="contact-link" href="#contact">お問い合わせ</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    width: 100%;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid #e8edf3;
    backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: 1120px;
    min-height: 72px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-logo {
    display: block;
    width: 150px;
    height: 58px;
    object-fit: contain;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    flex: 1;
  }

  .nav a {
    color: #4b5563;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .nav a:hover,
  .nav a:focus-visible {
    color: #1d4ed8;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    border: 1px solid #111827;
    border-radius: 6px;
    color: #111827;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    background: #111827;
    color: #ffffff;
  }

  @media (max-width: 760px) {
    .header-inner {
      min-height: 64px;
      padding: 0 18px;
    }

    .nav {
      display: none;
    }

    .contact-link {
      min-height: 38px;
      padding: 0 14px;
      font-size: 0.86rem;
    }
  }
</style>
