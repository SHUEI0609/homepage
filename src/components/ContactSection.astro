---
const contactItems = [
  { label: "ああああ", value: "ああああああああ" },
  { label: "ああああ", value: "ああああああああ" },
];
---

<section class="contact-section" id="contact" aria-labelledby="contact-title">
  <div class="section-inner">
    <div class="contact-panel">
      <div class="section-heading">
        <p class="section-kicker">CONTACT</p>
        <h2 id="contact-title">お問い合わせ</h2>
        <p>ああああああああああああああああ。ああああああああ。</p>
      </div>

      <div class="contact-content">
        <dl>
          {contactItems.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>

        <a class="contact-button" href="mailto:example@example.com">お問い合わせする</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    border-top: 1px solid #e5e7eb;
    background: #f8fafc;
  }

  .section-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 96px 24px;
  }

  .contact-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: 48px;
    border: 1px solid #d7d7d7;
    border-radius: 8px;
    padding: 48px;
    background: #ffffff;
  }

  .section-heading {
    display: grid;
    gap: 12px;
  }

  .section-kicker {
    margin: 0;
    color: #6b7280;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .section-heading h2 {
    margin: 0;
    color: #111827;
    font-size: 2.2rem;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .section-heading p {
    margin: 8px 0 0;
    color: #4b5563;
    font-weight: 600;
    line-height: 1.9;
  }

  .contact-content {
    display: grid;
    align-content: space-between;
    gap: 28px;
  }

  .contact-content dl {
    display: grid;
    gap: 18px;
    margin: 0;
  }

  .contact-content div {
    display: grid;
    gap: 6px;
    padding-bottom: 18px;
    border-bottom: 1px solid #e5e7eb;
  }

  .contact-content dt {
    color: #6b7280;
    font-size: 0.86rem;
    font-weight: 700;
  }

  .contact-content dd {
    margin: 0;
    color: #111827;
    font-size: 1rem;
    font-weight: 800;
  }

  .contact-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px solid #111827;
    border-radius: 6px;
    color: #111827;
    font-weight: 800;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .contact-button:hover,
  .contact-button:focus-visible {
    background: #111827;
    color: #ffffff;
  }

  @media (max-width: 800px) {
    .section-inner {
      padding: 72px 18px;
    }

    .contact-panel {
      grid-template-columns: 1fr;
      padding: 32px 24px;
    }

    .section-heading h2 {
      font-size: 1.8rem;
    }
  }
</style>
