---
const footerGroups = [
  {
    title: "ABOUT US / 私たちについて",
    links: [
      { href: "#company", label: "COMPANY / データで見るauペイメント" },
      { href: "#vision", label: "VISION / 求める人物像" },
      { href: "#business", label: "BUSINESS / 事業内容" },
    ],
  },
  {
    title: "CULTURE / 文化",
    links: [],
  },
  {
    title: "JOB LIST / 募集要項",
    links: [
      { href: "#career", label: "キャリア採用" },
      { href: "#new-graduate", label: "新卒採用（特設サイト）" },
      { href: "#faq", label: "FAQ" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-main">
    <nav class="footer-groups" aria-label="フッターナビゲーション">
      {footerGroups.map((group) => (
        <section class="footer-group">
          <a class="footer-heading" href="#">
            <span class="footer-heading-icon" aria-hidden="true">›</span>
            <span>{group.title}</span>
          </a>

          {group.links.length > 0 && (
            <ul class="footer-links">
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}
    </nav>

    <a class="back-to-top" href="#" aria-label="ページ上部へ戻る">
      <span aria-hidden="true"></span>
    </a>
  </div>

  <div class="footer-bottom">
    <a class="corporate-link" href="#">
      <span>コーポレートサイト</span>
      <span class="external-icon" aria-hidden="true"></span>
    </a>
    <small>Copyright &copy; au Payment Corporation All rights reserved.</small>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    border-top: 1px solid #d7d7d7;
    background: #ffffff;
    color: #171717;
  }

  .footer-main {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: 76px 48px 72px;
  }

  .footer-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 38px;
    max-width: 900px;
  }

  .footer-group {
    min-width: 0;
  }

  .footer-heading {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid #b9b9b9;
    color: #111111;
    font-size: 1.02rem;
    font-weight: 800;
    line-height: 1.35;
    text-decoration: none;
  }

  .footer-heading-icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 18px;
    height: 18px;
    border: 1px solid #b9b9b9;
    border-radius: 50%;
    background: #ffffff;
    color: #111111;
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1;
  }

  .footer-links {
    display: grid;
    gap: 19px;
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    color: #4b4b4b;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.5;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .footer-heading:hover,
  .footer-heading:focus-visible,
  .footer-links a:hover,
  .footer-links a:focus-visible,
  .corporate-link:hover,
  .corporate-link:focus-visible {
    color: #111111;
  }

  .back-to-top {
    position: absolute;
    right: 34px;
    bottom: 0;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border: 1px solid #d7d7d7;
    border-radius: 50%;
    background: #ffffff;
    text-decoration: none;
    transform: translateY(50%);
    transition:
      background-color 160ms ease,
      transform 160ms ease;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    background: #ffffff;
    transform: translateY(50%) scale(1.04);
  }

  .back-to-top span {
    width: 22px;
    height: 22px;
    border-top: 4px solid #111111;
    border-left: 4px solid #111111;
    transform: translateY(5px) rotate(45deg);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    border-top: 1px solid #d7d7d7;
    padding: 31px max(48px, calc((100vw - 1280px) / 2 + 48px)) 34px;
    color: #4b4b4b;
  }

  .corporate-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #333333;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .external-icon {
    position: relative;
    display: inline-block;
    width: 10px;
    height: 10px;
    border: 2px solid #111111;
  }

  .external-icon::after {
    position: absolute;
    top: -5px;
    right: -5px;
    width: 7px;
    height: 7px;
    border-top: 2px solid #111111;
    border-right: 2px solid #111111;
    content: "";
  }

  .footer-bottom small {
    color: #4b4b4b;
    font-size: 0.86rem;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .footer-main {
      padding: 56px 24px 66px;
    }

    .footer-groups {
      grid-template-columns: 1fr;
      gap: 36px;
      max-width: none;
    }

    .footer-links {
      margin-top: 24px;
    }

    .back-to-top {
      right: 24px;
      width: 62px;
      height: 62px;
    }

    .footer-bottom {
      display: grid;
      gap: 18px;
      padding: 28px 24px 32px;
    }
  }
</style>
